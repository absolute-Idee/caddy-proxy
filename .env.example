# Domain with an A record pointing at the VPS (DNS only, no CDN proxying)
DOMAIN=example.com

# Email for Let's Encrypt account / expiry notices
EMAIL=you@example.com

# Proxy credentials. Generate the password with: openssl rand -base64 32 | tr -d '/+='
PROXY_USER=change-me
PROXY_PASS=change-me

# Secret hostname that triggers the 407 auth prompt. Must end in .localhost.
# Generate with: echo "$(openssl rand -hex 8).localhost"
PROBE_DOMAIN=change-me.localhost
